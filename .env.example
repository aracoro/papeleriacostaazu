# =====================================================================
#  Papelería Costa Azul - Configuración
#  Copia este archivo como .env y llena los valores de TiDB Cloud.
# =====================================================================

# ---------- Frontend ----------
VITE_API_URL=/api

# ---------- API ----------
API_PORT=4000
UPLOAD_BASE_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:5173
APP_TIMEZONE=America/Mazatlan

# Cadena larga y aleatoria para firmar las sesiones (no la compartas)
SESSION_SECRET=CAMBIA_ESTO_POR_UNA_CADENA_LARGA_Y_ALEATORIA
SESSION_HOURS=8

# ---------- TiDB Cloud Data Service (transacciones) ----------
# URL base de tu Data App, HASTA /endpoint (sin la ruta del endpoint). Ejemplo:
# https://us-east-1.data.tidbcloud.com/api/v1beta/app/dataapp-AbCdEf12/endpoint
DATASERVICE_URL=
DATASERVICE_PUBLIC_KEY=
DATASERVICE_PRIVATE_KEY=
# true = llama a la versión "draft" (sin desplegar) de los endpoints. Déjalo en false.
DATASERVICE_DRAFT=false

# ---------- Conexión directa a TiDB (solo para el respaldo .sql) ----------
# Datos del botón "Connect" de tu cluster en TiDB Cloud
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=papeleria_costa_azul
# Usuario de BD administrador (ver database/03_usuarios_bd.sql)
DB_USER=xxxxxxxxxxxx.administrador
DB_PASSWORD=
DB_SSL=true
